<aside>
  <section class="latest-episodes">
    <h3>Latest episodes</h3>
    <ul>
      <% totalEpisodes.forEach((ep) => { %>
        <li>
          <a href="/episode?pc=<%= ep.podcastIndex %>&ep=<%= ep.episodeIndex %>">
            <%= ep.title %>
          </a>
        </li>
      <% }); %>
    </ul>
  </section>
</aside>
